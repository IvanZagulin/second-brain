# Copy to deploy/.env on the server (never commit the real file).
ENVIRONMENT=production
LOG_LEVEL=INFO

POSTGRES_DB=brain
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me-long-random

# Claude API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-...
# Outbound proxy for api.anthropic.com when the VPS region is blocked, e.g. http://user:pass@host:port
ANTHROPIC_PROXY=

# Random 32+ chars; pepper for device-token hashes. Changing it logs out every device.
SECRET_KEY=change-me

PUBLIC_BASE_URL=https://brain.example.com
DEFAULT_TIMEZONE=Europe/Moscow
GITHUB_REPO=IvanZagulin/second-brain

# Firebase files placed in deploy/secrets/
FCM_SERVICE_ACCOUNT_FILE=fcm-service-account.json
FCM_CLIENT_CONFIG_FILE=google-services.json
FCM_USE_PROXY=false

# Backups (deploy/scripts/backup.sh)
BACKUP_PASSPHRASE=change-me-long-random
BACKUP_KEEP_DAYS=30
BACKUP_AT=04:00
BACKUP_DIR=/var/backups/second-brain
TZ=Europe/Moscow
